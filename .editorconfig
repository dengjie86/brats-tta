root = true

# Limit editor defaults to maintained files; frozen snapshots keep their bytes.
[{src,tests}/**.py]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true

[{configs,.github}/**.{yaml,yml}]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true

[docs/guides/**.md]
charset = utf-8
insert_final_newline = true
